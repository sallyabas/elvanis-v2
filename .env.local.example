# Supabase — new, isolated project (never the old Elvanis project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — consumed only by src/lib/ai-client, never called directly elsewhere
GROQ_API_KEY=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b

# Resend — consumed only by src/lib/notifications/send-email.ts, never called directly elsewhere
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Base URL used to build links in notification emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tavily — consumed only by src/lib/search-client, never called directly elsewhere.
# Powers Commercial/Market's independent research step (src/lib/lenses/commercial-research.ts)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Cron — Vercel sends this as `Authorization: Bearer $CRON_SECRET` automatically
# when set as a Vercel env var; must also be set on the deployed project, not just here.
CRON_SECRET=

# Unsubscribe — HMAC-signs no-login unsubscribe links in transactional emails
UNSUBSCRIBE_SECRET=

# Reviewer "second opinion" (confirmed 2026-09-04) — deliberately a
# SEPARATE provider from AI_PROVIDER/GROQ_API_KEY above (src/lib/ai-client),
# not a toggle on it — see src/lib/second-opinion-client/config.ts's own
# docblock. Genuine model independence from whatever drafted the finding is
# the entire point. Reviewer-triggered on demand only, never wired into
# runAudit()'s critical path.
SECOND_OPINION_PROVIDER=
SECOND_OPINION_MODEL=
ANTHROPIC_API_KEY=


# Playwright E2E suite (tests/e2e/) — confirmed 2026-09-02, see
# tests/e2e/README.md for the full picture.
# ALLOW_TEST_AUTH/TEST_AUTH_SECRET gate src/app/api/test/auth/route.ts —
# NEVER set ALLOW_TEST_AUTH=true on the production Vercel project. Only
# for local dev and a dedicated preview/staging deployment the suite
# targets. playwright.config.ts sets both automatically for a local run
# (via webServer.env) if left blank here.
ALLOW_TEST_AUTH=
TEST_AUTH_SECRET=
# Where the suite points its browser — defaults to http://localhost:3000
# (and auto-starts `npm run dev`) when left blank; set to a real deployed
# preview/staging URL to run the suite against a live deploy instead.
E2E_BASE_URL=
